# =============================================================================
# Orchestrator Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Core (Required)
# -----------------------------------------------------------------------------

# URL of your MCPJungle server
JUNGLE_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# Supabase - Tool Registry (Required for Discovery)
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=

# Your Supabase service role key (Dashboard > Settings > API > service_role)
SUPABASE_KEY=

# -----------------------------------------------------------------------------
# OpenAI - Embeddings & Query Expansion (Required for Search)
# -----------------------------------------------------------------------------

# Your OpenAI API key (for generating embeddings and query expansion)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Optional - Only needed for advanced features
# -----------------------------------------------------------------------------

# Port for orchestrator (default: 8080)
# PORT=8080

# Routing: "shared" (default) = everyone uses JUNGLE_URL
#          "per_user" = each user gets their own container (needs PROVISIONER)
# ROUTING_MODE=shared

# For per-user mode: "docker" spins up containers, "k8s" for Kubernetes
# PROVISIONER=docker
# PROVISION_ON_DEMAND=true
